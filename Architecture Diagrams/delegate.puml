@startuml
title Delegation Interaction (Human Actors)

skinparam linetype ortho
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #333333
}

actor "Joe\n(Delegator)" as Joe
actor "Joe\n(Delegate)" as Joe

Joe -[#000]-> Joe : 1. Delegates authority\n(scope, conditions)
Joe -[#000]-> Joe : 2. Acts on behalf of Joe\nwithin delegation

@enduml