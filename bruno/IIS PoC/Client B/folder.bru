meta {
  name: Client B
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: {{redirect_uri}}
  authorization_url: {{keycloak_realm_uri}}/protocol/openid-connect/auth
  access_token_url: {{keycloak_realm_uri}}/protocol/openid-connect/token
  refresh_token_url: 
  client_id: {{client_b}}
  client_secret: {{client_b_secret}}
  scope: openid profile read:sdpr
  state: 
  pkce: true
  credentials_placement: body
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}
