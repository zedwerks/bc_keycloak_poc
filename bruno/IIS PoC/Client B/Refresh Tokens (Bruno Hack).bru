meta {
  name: Refresh Tokens (Bruno Hack)
  type: http
  seq: 1
}

post {
  url: {{keycloak_realm_uri}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{$oauth2.credentials.refresh_token}}
  client_id: {{client_b}}
  client_secret: {{client_b_secret}}
}

script:post-response {
  // Parse JSON response
  // Ensure response is JSON
  const body = res.getBody();
  
  // Validate token exists
  if (!body.access_token) {
    throw new Error("No access_token found in auth response");
  }
  
  // Save token under a CLIENT-SPECIFIC name
  bru.setEnvVar("client_b_access_token", body.access_token);
  
  // Optional: save other useful fields
  bru.setEnvVar("client_b_refresh_token", body.refresh_token);
  
  // Debug log
  console.log("Client B access token saved");
  
}

settings {
  encodeUrl: true
  timeout: 0
}
