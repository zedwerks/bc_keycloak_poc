meta {
  name: Step 1: Service Account Authentication
  type: http
  seq: 1
}

post {
  url: {{keycloak_realm_uri}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  client_id: {{client_k}}
  client_secret: {{client_k_secret}}
  scope: fin:cra:taxes:read
  grant_type: client_credentials
}

script:post-response {
  const body = res.getBody();
  
  // Validate token exists
  if (!body.access_token) {
    throw new Error("No access_token found in auth response");
  }
  
  // Save token under a CLIENT-SPECIFIC name
  bru.setEnvVar("service_delegate_access_token", body.access_token);
  
  const service_account_client_id = bru.getEnvVar("client_k");
  bru.setEnvVar("service_delegate_client_id", service_account_client_id );
}

settings {
  encodeUrl: true
  timeout: 0
}
