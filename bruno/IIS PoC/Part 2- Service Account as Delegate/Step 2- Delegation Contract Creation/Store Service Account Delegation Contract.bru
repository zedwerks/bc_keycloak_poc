meta {
  name: Store Service Account Delegation Contract
  type: http
  seq: 2
}

post {
  url: {{delegation_server}}/delegations
  body: json
  auth: inherit
}

body:json {
  {
      "delegate": {
          "service_account_client_id": "{{service_delegate_client_id}}"
      },
      "delegator": {
          "user_id": "{{delegator_user_id}}"
      },
      "scope": [
          "fin:cra:taxes:read",
          "sdpr:myss:case:write"
      ],
      "status": "active",
      "purpose": "AFA Application",
      "expires_at": 1794024830
  }
}

body:form-urlencoded {
  ~subject_token: {{delegator_access_token}}
}

script:post-response {
  // Ensure response is JSON
  const body = res.getBody();
  
  // Validate token exists
  if (!body.delegation_contract_id) {
    throw new Error("No delegation_contract_id found in response");
  }
  
  // Save delegator user identifier.
  // we will need this for building up the delegation
  // context json.
  bru.setEnvVar("service_delegation_contract_id", body.delegation_contract_id);
}

settings {
  encodeUrl: true
  timeout: 0
}
