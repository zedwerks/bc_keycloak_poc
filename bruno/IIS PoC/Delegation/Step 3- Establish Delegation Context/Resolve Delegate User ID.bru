meta {
  name: Resolve Delegate User ID
  type: http
  seq: 1
}

post {
  url: {{keycloak_realm_uri}}/delegation/resolve-user
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  subject_token: {{delegate_access_token}}
}

script:post-response {
  // Ensure response is JSON
  const body = res.getBody();
  
  // Validate token exists
  if (!body.user_id) {
    throw new Error("No user_id found in response");
  }
  
  // Save delegator user identifier.
  // we will need this for building up the delegation
  // context json.
  bru.setEnvVar("delegate_user_id", body.user_id);
  
  
}

settings {
  encodeUrl: true
  timeout: 0
}
