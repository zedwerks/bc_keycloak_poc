meta {
  name: Step 2: Delegate  Login (Joe) Sector A
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: {{redirect_uri}}
  authorization_url: {{keycloak_realm_uri}}/protocol/openid-connect/auth
  access_token_url: {{keycloak_realm_uri}}/protocol/openid-connect/token
  refresh_token_url: 
  client_id: {{client_a1}}
  client_secret: {{client_a1_secret}}
  scope: fin:cra:taxes:read profile
  state: 
  pkce: true
  credentials_placement: body
  credentials_id: delegate-token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: false
  auto_refresh_token: false
}

auth:oauth2:additional_params:auth_req:queryparams {
  login_hint: joe
}
