meta {
  name: Step 3: Delegation Service
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{keycloak_realm_uri}}/protocol/openid-connect/token
  refresh_token_url: 
  client_id: {{client_d}}
  client_secret: {{client_d_secret}}
  scope: openid iis:delegation:resolve:user
  credentials_placement: body
  credentials_id: credentials-delegation-svc
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}
