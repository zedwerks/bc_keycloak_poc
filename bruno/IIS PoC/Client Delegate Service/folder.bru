meta {
  name: Client Delegate Service
  seq: 2
}

auth {
  mode: oauth2
}

auth:oauth2 {
  grant_type: client_credentials
  access_token_url: {{keycloak_realm_uri}}/protocol/openid-connect/token
  refresh_token_url: 
  client_id: {{client_d}}
  client_secret: {{client_d_secret}}
  scope: openid
  credentials_placement: body
  credentials_id: credentials
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: false
}

docs {
  # About
  This represents the Delegate Service, which will perform this Token Exchange 
  when it receives an 'exchange' request from a Client, like Clien A.
  
  - We pass in the access_token for Alice for Client A, and we use the subject id for Amina.
  
  
}
