meta {
  name: Refresh Tokens (Bruno Hack)
  type: http
  seq: 1
}

post {
  url: {{keycloak_realm_uri}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: refresh_token
  refresh_token: {{refresh_token_client_a1}}
  client_id: {{client_a1}}
  client_secret: {{client_a1_secret}}
}

vars:pre-request {
  refresh_token_client_a1: {{$oauth2.credentials.refresh_token}}
}

script:post-response {
  // Ensure response is JSON
  const body = res.getBody();
  
  // Validate token exists
  if (!body.access_token) {
    throw new Error("No access_token found in auth response");
  }
  
  // Save token under a CLIENT-SPECIFIC name
  bru.setEnvVar("client_a1_access_token", body.access_token);
  
  // Optional: save other useful fields
  bru.setEnvVar("client_a1_refresh_token", body.refresh_token);
  
  // Debug log
  console.log("Client A access token saved");
  
  function base64UrlDecode(str) {
    str = str.replace(/-/g, '+').replace(/_/g, '/');
    const pad = str.length % 4;
    if (pad) {
      str += '='.repeat(4 - pad);
    }
    return Buffer.from(str, 'base64').toString('utf8');
  }
  
  
  var token = body.access_token
  
  const [, payload] = token.split('.');
  const decodedPayload = JSON.parse(base64UrlDecode(payload));
  
  console.log(JSON.stringify(decodedPayload, null, 2));
  
}

tests {
  console.log(bru.getEnvVar("token_client_a1"))
}

settings {
  encodeUrl: true
  timeout: 0
}
